rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(myUid())).data.role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isStaffOrAdmin() {
      return isSignedIn() && (myRole() == 'staff' || myRole() == 'admin');
    }

    function isProfessor() {
      return isSignedIn() && myRole() == 'professor';
    }

    // El profesor dueño del curso (professorId == myUid()). Se usa para que un profesor
    // solo pueda crear notas/asistencia de SUS propios cursos, no de cursos ajenos.
    function ownsCourse(courseId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/courses/$(courseId)).data.professorId == myUid();
    }

    // ----- Users -----
    match /users/{uid} {
      // 2026-09-13: antes "allow read: if isSignedIn()" dejaba leer TODO el directorio
      // (email, rol, código, foto, fcmToken de cualquiera) a cualquier usuario autenticado,
      // incluidos estudiantes. Ahora cada quien lee su propio perfil; profesor/staff/admin
      // pueden leer otros perfiles porque lo necesitan (listar estudiantes matriculados en
      // MyCoursesScreen/AttendanceScreen/GradeEntryScreen, directorio institucional, etc.).
      allow read: if isSignedIn() && (myUid() == uid || isProfessor() || isStaffOrAdmin());
      allow create: if isSignedIn() && myUid() == uid;
      // Owners may edit their own profile, but never their role or active flag.
      allow update: if isSignedIn() && myUid() == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.active == resource.data.active
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ----- News / institutional announcements -----
    // 2026-09-17: lectura pública (antes exigía isSignedIn()) porque el sitio web
    // público (appeafit-web-frontend) muestra estas mismas noticias en su sección
    // "Noticias" a visitantes anónimos, sin que inicien sesión -- son anuncios
    // institucionales públicos, no hay ningún dato sensible en este documento.
    match /news/{newsId} {
      allow read: if true;
      allow create: if isProfessor() || isStaffOrAdmin();
      allow update, delete: if isStaffOrAdmin();
    }

    // ----- Hero del sitio web (imágenes/videos en loop de la portada) -----
    // 2026-09-17: colección nueva para appeafit-web-frontend. Lectura pública
    // (el hero se ve sin iniciar sesión, igual que el resto del sitio público).
    // La escritura queda para el panel de Admin -- por ahora solo vía consola de
    // Firebase; agregar la pantalla de gestión en la app móvil (mismo patrón que
    // ManageAnnouncementsScreen) queda como pendiente explícito, ver BITACORA.
    match /hero_slides/{slideId} {
      allow read: if true;
      allow create, update, delete: if isStaffOrAdmin();
    }

    // ----- Mensajes del formulario de contacto del sitio web -----
    // 2026-09-17: el backend (appeafit-web-backend) los crea con Admin SDK
    // (bypasa las reglas), así que este `create` público es un respaldo por si
    // en el futuro se escribiera directo desde el cliente sin backend. La
    // lectura queda para Staff/Admin -- contiene datos personales (nombre,
    // correo, teléfono) de personas que no necesariamente tienen cuenta.
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isStaffOrAdmin();
    }

    // ----- Academic calendar -----
    match /calendarEvents/{eventId} {
      allow read: if isSignedIn();
      allow write: if isStaffOrAdmin();
    }

    // ----- Courses & enrollments -----
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isStaffOrAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow write: if isStaffOrAdmin();
    }

    // ----- Grades: only the owning student and any professor may read/write -----
    match /grades/{gradeId} {
      allow read: if isSignedIn() &&
        (resource.data.studentId == myUid() || isProfessor() || isStaffOrAdmin());
      // 2026-09-13: antes cualquier profesor autenticado podía crear/editar notas de
      // CUALQUIER curso (solo se validaba el rol, no el dueño del curso). Ahora se exige
      // que el curso de la nota (request.resource.data.courseId) le pertenezca.
      allow create, update: if isStaffOrAdmin() ||
        (isProfessor() && ownsCourse(request.resource.data.courseId));
      allow delete: if isStaffOrAdmin();
    }

    // ----- Attendance -----
    match /attendance/{sessionId} {
      allow read: if isProfessor() || isStaffOrAdmin();
      // 2026-09-13: mismo problema que en `grades` — se exige pertenencia del curso.
      allow create: if isStaffOrAdmin() ||
        (isProfessor() && ownsCourse(request.resource.data.courseId));
      allow update, delete: if isStaffOrAdmin();
    }

    // ----- Teacher evaluations: students can create their own and check if they already
    // evaluated a course; only staff/admin can read the full list (with scores) -----
    match /teacherEvaluations/{evalId} {
      // 2026-09-13: antes "allow read: if isStaffOrAdmin()" impedía que el propio estudiante
      // consultara si YA había evaluado un curso (TeacherEvaluationRepository.hasEvaluated()
      // recibía PERMISSION_DENIED, el error se tragaba y el estudiante podía evaluar el mismo
      // curso varias veces). Ahora puede leer sus propias evaluaciones (no las de otros).
      allow read: if isStaffOrAdmin() || (isSignedIn() && resource.data.studentId == myUid());
      allow create: if isSignedIn() && request.resource.data.studentId == myUid();
      allow update, delete: if isAdmin();
    }

    // ----- Library loans -----
    match /loans/{loanId} {
      allow read: if isSignedIn() &&
        (resource.data.studentId == myUid() || isStaffOrAdmin());
      allow update: if isSignedIn() &&
        (resource.data.studentId == myUid() || isStaffOrAdmin());
      allow create, delete: if isStaffOrAdmin();
    }

    // ----- Notifications -----
    match /notifications/{notificationId} {
      allow read: if isSignedIn() &&
        (resource.data.targetUserId == myUid() ||
         resource.data.targetRole == 'all' ||
         resource.data.targetRole == myRole());
      // 2026-09-13: antes "allow update: if isSignedIn()" dejaba que CUALQUIER usuario
      // autenticado reescribiera title/body/targetRole/targetUserId de cualquier
      // notificación ya enviada (se usaba solo para marcar "leído", pero la regla no lo
      // limitaba a eso). El contenido de una notificación ya creada ahora es inmutable
      // salvo para el admin; el estado de "leído" se maneja por usuario en la subcolección
      // `reads` de abajo, no en el documento compartido.
      allow create, update, delete: if isAdmin();
    }

    // Marcador de "leído" por usuario, en notifications/{notificationId}/reads/{uid}.
    // Reemplaza el antiguo campo compartido `read` del documento de notificación (que
    // quedaba "leído" para TODOS los destinatarios en cuanto uno solo lo abría).
    //
    // 2026-09-16: se declara como "match /{path=**}/reads/{uid}" (NO anidado dentro de
    // /notifications) porque un match anidado normal NO se aplica a collectionGroup
    // queries. NotificationRepository.listFor() usa
    // collectionGroup("reads").whereEqualTo("uid", userId), y con el match anidado esa
    // consulta devolvía PERMISSION_DENIED sin importar la condición probada -- se intentó
    // "myUid() == uid" (el segmento de ruta), un OR agregando
    // "resource.data.uid == myUid()", e incluso "if isSignedIn()" a secas; las tres
    // fallaban igual, confirmado también con pruebas directas contra la API REST de
    // Firestore fuera de la app (no era caché del cliente ni demora de propagación). Con
    // "{path=**}" la consulta sí queda autorizada. Como este documento solo contiene el
    // uid de quien leyó + la fecha (nada sensible), se permite la lectura a cualquier
    // usuario autenticado; el create sigue exigiendo que el campo y el segmento de ruta
    // coincidan con el uid del solicitante.
    match /{path=**}/reads/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && myUid() == uid && request.resource.data.uid == uid;
      allow update, delete: if false;
    }
  }
}
